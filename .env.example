# Shared password that unlocks every protected case study.
CASE_PASSWORD=

# Signing key for the access cookie. At least 32 random bytes, e.g. `openssl rand -base64 48`.
AUTH_SECRET=

# Resend API key for the home contact form (https://resend.com/api-keys).
RESEND_API_KEY=

# Where contact form messages go.
CONTACT_TO=

# Optional sender, on a domain verified in Resend, e.g. `Portfolio <hello@example.com>`. Defaults to Resend's test sender.
CONTACT_FROM=
